{
  "buildCommand": "node tools/status.mjs --check && npx -y seolint@1.1.1",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "daystart.bananaintelligence.ai" }],
      "destination": "https://daystartai.app/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/privacy", "has": [{ "type": "host", "value": "daystart.bananaintelligence.ai" }], "destination": "/daystart/privacy/index.html" },
    { "source": "/privacy/", "has": [{ "type": "host", "value": "daystart.bananaintelligence.ai" }], "destination": "/daystart/privacy/index.html" },
    { "source": "/terms", "has": [{ "type": "host", "value": "daystart.bananaintelligence.ai" }], "destination": "/daystart/terms/index.html" },
    { "source": "/terms/", "has": [{ "type": "host", "value": "daystart.bananaintelligence.ai" }], "destination": "/daystart/terms/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
